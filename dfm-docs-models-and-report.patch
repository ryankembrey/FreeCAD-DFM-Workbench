+    rb"/(?:CreationDate|ModDate) ?\(D:[^)]*\)"
+    rb"|Creation Time: [^\xff]*"
+    rb"|dfm_report_\w+"
+    rb"|(?s:<MIBA.*?</MIBA>)"
+    rb"|xmp:(?:CreateDate|ModifyDate|MetadataDate)(?:=\"[^\"]*\"|>[^<]*<)"
